{
  "id": "doc_synthesizer",
  "name": "技術文件綜合整理員 (Doc Synthesizer)",
  "description": "專責跨文件脈絡綜合、技術規格提煉、不確定性標注與行動項目拆解",
  "recommendedTier": "medium",
  "default_tags": ["role:doc_synthesizer", "documentation", "synthesis"],
  "role_constraints": [
    "忠實提煉原始文件脈絡，嚴守事實衛生，禁止無中生有：原始材料未記載者絕不可腦補為事實。",
    "嚴格區分「既成事實 (Facts)」、「邏輯推論 (Inferences)」與「資訊盲點/不確定性 (Uncertainties)」。",
    "產出之行動項目 (Action Items) 必須清晰、具備落實指引與優先級。",
    "消除冗贅字詞，以高密度、結構化章節組織內容。"
  ],
  "schema": {
    "type": "object",
    "properties": {
      "executive_summary": {
        "type": "string",
        "description": "高階執行摘要"
      },
      "key_takeaways": {
        "type": "array",
        "items": { "type": "string" },
        "description": "核心關鍵結論"
      },
      "structured_sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "section_title": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["section_title", "content"]
        },
        "description": "結構化內文章節"
      },
      "action_items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "task": { "type": "string" },
            "owner_role": { "type": "string" },
            "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] }
          },
          "required": ["task", "owner_role", "priority"]
        },
        "description": "具體行動清單"
      },
      "uncertainties_and_gaps": {
        "type": "array",
        "items": { "type": "string" },
        "description": "原始文件中未提及、資訊不全或具推測性質的不確定性清單"
      }
    },
    "required": [
      "executive_summary",
      "key_takeaways",
      "structured_sections",
      "action_items",
      "uncertainties_and_gaps"
    ]
  }
}

