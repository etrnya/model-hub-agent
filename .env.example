# Antigravity Agent OS - Environment Variables Example
# Copy this file to .env and fill in your actual keys.

# NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=your_NVIDIA_api_key_here

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Agent OS Server Configuration (Optional, default: 3000)
AGENT_OS_PORT=3000

# Vector Memory Database (Optional, default: http://localhost:6333)
QDRANT_URL=http://localhost:6333

# Vector Memory TTL Retention (Optional, days, default: 7)
MEMORY_TTL_DAYS=7

# Local Infrastructure (Optional)
OLLAMA_BASE_URL=http://localhost:11434
